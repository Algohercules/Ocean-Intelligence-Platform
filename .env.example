# Ocean Intelligence Platform - Environment Configuration

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Device & Deep Learning Execution
FORCE_CPU=false
MODEL_TYPE=conv_lstm
MODEL_INPUT_DIM=4
MODEL_HIDDEN_DIM=32
MODEL_OUTPUT_DIM=1
MODEL_KERNEL_SIZE=7
MODEL_NUM_LAYERS=2
MODEL_DROPOUT=0.2
MODEL_ATTN_ACTIVATION=sigmoid
MODEL_SEQ_LEN=3

# Streamlit UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
